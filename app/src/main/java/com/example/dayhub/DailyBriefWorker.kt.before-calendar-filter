package com.example.dayhub

import android.Manifest
import android.app.NotificationChannel
import android.app.NotificationManager
import android.content.Context
import android.content.pm.PackageManager
import android.location.LocationManager
import android.os.Build
import android.provider.CalendarContract
import androidx.core.app.NotificationCompat
import androidx.work.Worker
import androidx.work.WorkerParameters
import org.json.JSONObject
import java.net.HttpURLConnection
import java.net.URL
import java.text.SimpleDateFormat
import java.util.Calendar
import java.util.Date
import java.util.Locale

class DailyBriefWorker(ctx: Context, params: WorkerParameters) : Worker(ctx, params) {
    override fun doWork(): Result {
        val prefs = applicationContext.getSharedPreferences(BriefPreferences.FILE, Context.MODE_PRIVATE)
        val legacyPrefs = applicationContext.getSharedPreferences("brief", Context.MODE_PRIVATE)
        val manual = inputData.getBoolean("manual", false)
        if (!manual && !prefs.getBoolean(BriefPreferences.ENABLED, true)) return Result.success()
        val cal = Calendar.getInstance()
        val hour = cal.get(Calendar.HOUR_OF_DAY)
        if (!manual && (hour < 8 || hour >= 12)) return Result.success()
        val today = SimpleDateFormat("yyyyMMdd", Locale.US).format(Date())
        val lastSent = prefs.getString(BriefPreferences.LAST_SENT, null)
            ?: legacyPrefs.getString(BriefPreferences.LAST_SENT, "")
        if (!manual && lastSent == today) return Result.success()
        if (Build.VERSION.SDK_INT >= 33 && applicationContext.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) return Result.success()
        val details = mutableListOf<String>()
        try {
            if (applicationContext.checkSelfPermission(Manifest.permission.READ_CALENDAR) == PackageManager.PERMISSION_GRANTED) {
                val start = System.currentTimeMillis()
                val end = start + 24L * 3600000
                val uri = CalendarContract.Instances.CONTENT_URI.buildUpon().also {
                    android.content.ContentUris.appendId(it, start)
                    android.content.ContentUris.appendId(it, end)
                }.build()
                applicationContext.contentResolver.query(uri, arrayOf(CalendarContract.Instances.TITLE, CalendarContract.Instances.BEGIN), null, null, CalendarContract.Instances.BEGIN + " ASC")?.use { c ->
                    var n = 0
                    val names = mutableListOf<String>()
                    while (c.moveToNext() && n < 3) {
                        names.add(SimpleDateFormat("HH:mm", Locale.getDefault()).format(Date(c.getLong(1))) + " " + (c.getString(0) ?: "Событие"))
                        n++
                    }
                    details.add(if (names.isEmpty()) "Календарь: ближайших событий нет" else "Календарь: " + names.joinToString("; "))
                }
            }
        } catch (_: Exception) { }
        try {
            if (applicationContext.checkSelfPermission(Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED || applicationContext.checkSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED) {
                val lm = applicationContext.getSystemService(Context.LOCATION_SERVICE) as LocationManager
                val loc = lm.getProviders(true).mapNotNull { lm.getLastKnownLocation(it) }.maxByOrNull { it.time }
                if (loc != null && System.currentTimeMillis() - loc.time < 24L * 3600000) {
                    val u = URL("https://api.open-meteo.com/v1/forecast?latitude=${loc.latitude}&longitude=${loc.longitude}&current=temperature_2m,wind_speed_10m&timezone=auto")
                    val conn = u.openConnection() as HttpURLConnection
                    conn.connectTimeout = 8000; conn.readTimeout = 8000
                    val raw = try { conn.inputStream.bufferedReader().use { it.readText() } } finally { conn.disconnect() }
                    val current = JSONObject(raw).getJSONObject("current")
                    details.add("Погода: ${current.optDouble("temperature_2m")}°C, ветер ${current.optDouble("wind_speed_10m")} км/ч")
                }
            }
        } catch (_: Exception) { }
        if (details.isEmpty()) details.add("Открой DayHub, чтобы проверить погоду и события")
        val manager = applicationContext.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
        val channelId = "dayhub_brief"
        manager.createNotificationChannel(NotificationChannel(channelId, "Утренняя сводка", NotificationManager.IMPORTANCE_DEFAULT))
        val content = details.joinToString("\n")
        val notification = NotificationCompat.Builder(applicationContext, channelId)
            .setSmallIcon(android.R.drawable.ic_dialog_info)
            .setContentTitle(if (manual) "DayHub · Сводка по запросу" else "DayHub · Утренняя сводка")
            .setContentText(details.first())
            .setStyle(NotificationCompat.BigTextStyle().bigText(content))
            .setAutoCancel(true)
            .build()
        manager.notify(202, notification)
        if (!manual) prefs.edit().putString(BriefPreferences.LAST_SENT, today).apply()
        return Result.success()
    }
}
